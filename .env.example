APP_ENV=development
LOG_LEVEL=INFO
LOG_DIR=/app/logs
FRONTEND_PORT=80

# Database
DATABASE_URL=sqlite:///sqlite.db
RUN_MIGRATIONS_ON_STARTUP=true
POSTGRES_USER=greenhouse
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=greenhouse_db

# Security
SECRET_KEY=change-me-before-production-minimum-32-characters
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# AI
DEEPSEEK_API_KEY=your-deepseek-api-key
AI_CHAT_MODEL=deepseek-chat
GOOGLE_API_KEY=
OPENAI_API_KEY=
ENABLE_MCP=false

# MQTT
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=greenhouse
MQTT_PASSWORD=change-me-mqtt-password
MQTT_TLS_ENABLED=false
MQTT_TLS_CA_CERTS=
DEFAULT_MQTT_TOPIC_ID=1

# Redis
REDIS_URL=redis://localhost:6379/0

# Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Worker
RETENTION_CHECK_INTERVAL_SECONDS=3600
